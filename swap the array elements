/*Function to swap array elements
 * arr : array input
 */
class Solution {
  public:
    // Function to swap elements of the array
    void swapElements(vector<int> &arr) {
        if(arr.size()<=2){
            return;
        }
        // Your code here
        for(int i=0;i<arr.size()-2;i++){
            swap(arr[i],arr[i+2]);
        }
    }
};
