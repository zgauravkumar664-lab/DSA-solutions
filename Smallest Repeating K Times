class Solution {
  public:
    int findDuplicate(vector<int>& arr, int k) {
        // code here
       map<int,int>mp;
       for(int i=0;i<arr.size();i++){
           mp[arr[i]]++;
       }
       for(auto i:mp){
           if(i.second==k){
               return i.first;
           }
       }
       return -1;
    }
};
