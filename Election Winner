class Solution {
  public:
    vector<string> winner(vector<string> &arr) {
        // code here
        int max=INT_MIN;
        string ans="";
        map<string,int>mp;
        for(int i=0;i<arr.size();i++){
            mp[arr[i]]++;
        }
        for(auto i:mp){
            if(i.second>max){
                max=i.second;
                ans=i.first;
            }
        }
        return{ans,to_string(max)};
    }
};
