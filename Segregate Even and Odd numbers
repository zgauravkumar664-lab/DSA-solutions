class Solution {
  public:
    void segregateEvenOdd(vector<int>& arr) {
        // code here
        int i=0;
        int j=arr.size()-1;
        while(i<j){
            while(i<j&&arr[i]%2==0){
                i++;
            }
            while(i<j&&arr[j]%2!=0){
                j--;
            }
            if(i<j ){
            swap(arr[i],arr[j]);
            }
        }
        sort(arr.begin(),arr.begin()+i);
        sort(arr.begin()+i,arr.end());
    }
};
