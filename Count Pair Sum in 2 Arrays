
class Solution {
  public:
    int countPairs(vector<int>& arr1, vector<int>& arr2, int x) {
        // code here.
        int ans=0;
        int n=arr1.size();
        int i=0;
        int j=arr2.size()-1;
        while(i<n && j>=0){
            int sum= arr1[i]+arr2[j];
            if (sum==x){
                ans++;
                i++;
                j--;
            }
            else if(sum>x){
                j--;
            }
            else{
                i++;
            }
            }
        return ans;
    }
};
