class Solution {
  public:
    int visibleBuildings(vector<int>& arr) {
        // code here
        int max=arr[0];
        int count=1;
        for(int i=1;i<arr.size();i++){
            if(arr[i]>=max){
                max=arr[i];
                 count++;
            }
           
        }
        return count;
    }
};
