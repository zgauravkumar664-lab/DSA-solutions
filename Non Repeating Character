class Solution {
	public:
	char nonRepeatingChar(string &s) {
		//  code here
		char ans = '$';
		int alpha[26] = {0};
		for (int i = 0; i<s.size(); i++) {
			int num = s[i]-'a';
			alpha[num]++;
		}
		for (int i = 0; i<s.size(); i++) {
			int num = s[i]-'a';
			if (alpha[num] == 1) {
				return s[i];
			}
		}
		return ans;
	}
};
