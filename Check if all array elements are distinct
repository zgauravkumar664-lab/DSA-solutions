class Solution {
  public:
    bool isDistinct(vector<int> arr) {
        // code here
        map<int,int>mp;
        int i;
        for(int i=0;i<arr.size();i++){
            mp[arr[i]]++;
        }
        for(auto i:mp){
            if(i.second>1){
                return false;
            }
            
        }
        return true;
    }
};
